      "fontSize": 12,
      "fontFamily": 1,
      "text": "As a heavy-transport dispatcher, I want to check the exact permitted route against current and trustworthy road conditions so that I can decide whether the transport can depart without becoming stranded.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "As a heavy-transport dispatcher, I want to check the exact permitted route against current and trustworthy road conditions so that I can decide whether the transport can depart without becoming stranded.",
      "autoResize": true,
      "lineHeight": 1.25
    },
